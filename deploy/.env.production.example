# ============================================
# AquaMekong — biến môi trường trên server production
# ============================================
# Trên server: cp deploy/.env.production.example .env, rồi điền các ô trống.
# Không commit file .env. Các biến không có ở đây lấy giá trị mặc định của docker-compose.yml.

# --- Tên miền (Caddy xin chứng chỉ HTTPS cho tên này) ---
DOMAIN=aquamekong.kienhuy-dev.name.vn

# --- Database ---
POSTGRES_DB=aquamekong
POSTGRES_USER=aquamekong
# Chỉ dùng chữ và số (mật khẩu nằm trong DATABASE_URL của ml-service). Tạo bằng: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO
# Bắt buộc ở production, không thì mọi người bị đăng xuất mỗi lần deploy. Tạo bằng: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=8h
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@aquamekong.local
# Trống -> sinh ngẫu nhiên lần đầu, xem bằng: docker compose logs backend | grep "tài khoản admin"
ADMIN_PASSWORD=
INGEST_API_KEY=
# Trang web và app điện thoại (Capacitor)
CORS_ORIGINS=https://aquamekong.kienhuy-dev.name.vn,https://localhost,capacitor://localhost
PUBLIC_READ_ENABLED=true
REGISTRATION_ENABLED=true

# --- Đăng nhập (trống = ẩn nút) ---
# Google: thêm https://aquamekong.kienhuy-dev.name.vn vào "Authorized JavaScript origins"
GOOGLE_CLIENT_ID=
# Zalo: callback https://aquamekong.kienhuy-dev.name.vn/auth/zalo/callback
ZALO_APP_ID=
ZALO_APP_SECRET=
# Passkey gắn với tên miền: đổi tên miền thì passkey cũ không dùng được nữa
WEBAUTHN_RP_ID=aquamekong.kienhuy-dev.name.vn
WEBAUTHN_ORIGINS=https://aquamekong.kienhuy-dev.name.vn

# --- Thông báo đẩy (trống = tắt) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@aquamekong.local
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- ML Service ---
ENABLE_SCHEDULER=true
ENABLE_MOCK_CRAWLER=false
# Dữ liệu RYNAN (hỏi nhóm, không commit): file seed và folder Drive nhận file hằng ngày
SEED_DATA_URL=
GDRIVE_FOLDER_ID=
GDRIVE_API_KEY=

# --- Bản đang chạy ---
# deploy/deploy.sh ghi commit SHA vừa deploy vào đây, để các lệnh docker compose chạy tay giữ đúng bản đó
IMAGE_TAG=latest
