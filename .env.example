# ============================================
# AquaMekong Platform — Environment Variables
# ============================================
# Copy this file to .env and adjust values
# cp .env.example .env

# --- Database (PostgreSQL + PostGIS) ---
POSTGRES_DB=aquamekong
POSTGRES_USER=aquamekong
POSTGRES_PASSWORD=aquamekong_secret
# Port Postgres mở ra máy host (docker compose). Chạy backend/ML ngoài Docker thì
# trỏ tới localhost:<POSTGRES_HOST_PORT>, vd. DB_PORT=5433 ./mvnw spring-boot:run
POSTGRES_HOST_PORT=5433

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
LOG_LEVEL=INFO

# --- Bảo mật (đăng nhập JWT) ---
# Khoá ký token, >= 32 ký tự. Tạo bằng: openssl rand -base64 48
# Để trống: sinh ngẫu nhiên mỗi lần khởi động (mọi người bị đăng xuất khi restart)
JWT_SECRET=
JWT_EXPIRATION=8h
# Tài khoản admin được tạo lần đầu khi DB chưa có user nào.
# ADMIN_PASSWORD trống -> sinh ngẫu nhiên, xem bằng: docker compose logs backend | grep "tài khoản admin"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@aquamekong.local
ADMIN_PASSWORD=
# Khoá cho thiết bị IoT gọi POST /api/v1/measurements/ingest (header X-API-Key). Trống = tắt
INGEST_API_KEY=
# Origin của app điện thoại (Capacitor): https://localhost (Android), capacitor://localhost (iOS),
# http://localhost (bản build thử với backend http:// trong LAN, CAPACITOR_ALLOW_HTTP=true)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://localhost,http://localhost,capacitor://localhost
# Người chưa đăng nhập được xem bản đồ, số đo, dự báo, cảnh báo, báo cáo (chỉ đọc). false = bắt đăng nhập như trước
PUBLIC_READ_ENABLED=true
# Cho phép tự đăng ký (mật khẩu hoặc Google). Tài khoản tự đăng ký chỉ có ROLE_USER
REGISTRATION_ENABLED=true
# Đăng nhập Google: Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# "Authorized JavaScript origins" thêm http://localhost:5173, http://localhost:3000 và domain thật. Trống = ẩn nút Google
GOOGLE_CLIENT_ID=
# Đăng nhập Zalo: https://developers.zalo.me -> tạo ứng dụng -> Đăng nhập (Social API).
# Callback URL: http(s)://<domain>/auth/zalo/callback (vd. http://localhost:5173/auth/zalo/callback).
# App secret chỉ nằm ở backend. Thiếu một trong hai = ẩn nút Zalo
ZALO_APP_ID=
ZALO_APP_SECRET=
# Passkey (WebAuthn). RP_ID = tên miền trang web, không có http:// và cổng (vd. aquamekong.vn); trống = tắt.
# ORIGINS = các địa chỉ đầy đủ mở trang. Passkey gắn với RP_ID: đổi tên miền thì passkey cũ không dùng được.
# Chạy nhiều instance backend thì cần chuyển nơi lưu challenge (đang ở bộ nhớ) sang Redis.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000,http://localhost:5173
# Thông báo đẩy khi có cảnh báo mới.
# Trình duyệt (Web Push): tạo cặp khoá bằng `npx web-push generate-vapid-keys`. Trống = tắt.
# Đổi khoá thì mọi thiết bị phải bật thông báo lại. SUBJECT = liên hệ người vận hành (mailto: hoặc https:)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@aquamekong.local
# App điện thoại (FCM): Firebase Console -> Project settings -> Service accounts -> Generate new private key,
# rồi `base64 -w0 file.json`. Trống = tắt. App Android cần thêm google-services.json, xem README
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- ML Service (Python FastAPI) ---
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_PORT=8000
# Tắt nếu chạy nhiều replica ML để job crawl không chạy trùng
ENABLE_SCHEDULER=true
# Crawler sinh số ngẫu nhiên cho 6 trạm demo; để false khi đã nạp dữ liệu RYNAN thật
ENABLE_MOCK_CRAWLER=false
# Link Google Drive tới file dữ liệu RYNAN (hỏi nhóm). DB chưa có dữ liệu trạm thật thì ml-service tự tải về và nạp.
# File trên Drive phải đặt quyền "Bất kỳ ai có đường liên kết". Không commit link này.
SEED_DATA_URL=
# Folder Google Drive nhận file RYNAN hằng ngày (.github/workflows/rynan-daily.yml), ml-service tải về mỗi 20 phút.
# Folder đặt quyền "Bất kỳ ai có đường liên kết"; API key tạo ở Google Cloud Console, chỉ bật Drive API.
# Trống = tắt. Không commit hai giá trị này.
GDRIVE_FOLDER_ID=
GDRIVE_API_KEY=

# --- Frontend ---
# Để trống = gọi cùng origin qua proxy /api (khuyên dùng). Chỉ đặt khi API ở domain khác.
VITE_API_BASE_URL=
# 'true' để bật mock data khi API lỗi ở bản build production (dev luôn bật)
VITE_ENABLE_MOCK_FALLBACK=false
