# ============================================
# AquaMekong Platform — Environment Variables
# ============================================
# Copy this file to .env and adjust values
# cp .env.example .env

# --- Database (PostgreSQL + PostGIS) ---
POSTGRES_DB=aquamekong
POSTGRES_USER=aquamekong
POSTGRES_PASSWORD=aquamekong_secret
# Port Postgres mở ra máy host (docker compose). Chạy backend/ML ngoài Docker thì
# trỏ tới localhost:<POSTGRES_HOST_PORT>, vd. DB_PORT=5433 ./mvnw spring-boot:run
POSTGRES_HOST_PORT=5433

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
LOG_LEVEL=INFO

# --- Bảo mật (đăng nhập JWT) ---
# Khoá ký token, >= 32 ký tự. Tạo bằng: openssl rand -base64 48
# Để trống: sinh ngẫu nhiên mỗi lần khởi động (mọi người bị đăng xuất khi restart)
JWT_SECRET=
JWT_EXPIRATION=8h
# Tài khoản admin được tạo lần đầu khi DB chưa có user nào.
# ADMIN_PASSWORD trống -> sinh ngẫu nhiên, xem bằng: docker compose logs backend | grep "tài khoản admin"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@aquamekong.local
ADMIN_PASSWORD=
# Khoá cho thiết bị IoT gọi POST /api/v1/measurements/ingest (header X-API-Key). Trống = tắt
INGEST_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- ML Service (Python FastAPI) ---
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_PORT=8000
# Tắt nếu chạy nhiều replica ML để job crawl không chạy trùng
ENABLE_SCHEDULER=true

# --- Frontend ---
# Để trống = gọi cùng origin qua proxy /api (khuyên dùng). Chỉ đặt khi API ở domain khác.
VITE_API_BASE_URL=
# 'true' để bật mock data khi API lỗi ở bản build production (dev luôn bật)
VITE_ENABLE_MOCK_FALLBACK=false
