# Copy thành .env.mobile.local rồi sửa. Dùng cho `npm run build:mobile` (app Android/iOS).
# Địa chỉ backend mà điện thoại truy cập được, không có /api ở cuối.
#   Server thật:              https://aquamekong.vn
#   Máy ảo Android (emulator): http://10.0.2.2:8080   (cần CAPACITOR_ALLOW_HTTP=true khi build)
#   Điện thoại thật cùng WiFi: http://192.168.1.10:8080 (IP máy chạy backend, cần CAPACITOR_ALLOW_HTTP=true)
VITE_API_BASE_URL=https://aquamekong.vn
